NODE_ENV=development
PORT=9000
# 与 infra/docker-compose.yml 一致：宿主机 5432 → 容器内 Postgres 5432
DATABASE_URL=postgres://medusa:medusa@localhost:5432/ai_commerce
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-local-env
COOKIE_SECRET=change-me-in-local-env
DEFAULT_STORE_ID=default_store
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- 以下为可选 / 自检用；复制本文件为根目录 `.env` 后填写真实值 ---
# 真实密钥、token 只应写在 `.env`（已被 .gitignore），不要提交 `.env.example` 里的真实值。
#
# Store API 自检 scripts/phase1-dev2-self-test.sh 需要 publishable key：
# PUBLISHABLE_API_KEY=pk_...
#
# 仅脚本步骤 6（推履约 / mock 物流）；用 POST /auth/user/emailpass 取 JWT：
# ADMIN_TOKEN=eyJ...
