    {
      "name": "15 Cross-store publish is rejected",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Store-Id", "value": "{{test_store_id}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
