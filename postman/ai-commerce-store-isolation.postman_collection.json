      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Store-Id", "value": "{{default_store_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Smoke Default Category {{smoke_run_id}}\",\n  \"description\": \"Dev3 smoke category for default store\"\n}"
        },
        "url": "{{base_url}}/admin/product-categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('default_category_id', json.category_id);",
              "pm.test('category belongs to default store', () => {",
              "  pm.expect(json.store_id).to.eql(pm.environment.get('default_store_id'));",
              "  pm.expect(json.category.store_id).to.eql(pm.environment.get('default_store_id'));",
              "});",
              "pm.test('response includes slug and sort_order', () => {",
              "  pm.expect(json.category.slug).to.be.a('string').and.not.empty;",
              "  pm.expect(json.category.sort_order).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
