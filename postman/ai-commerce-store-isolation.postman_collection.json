{
  "info": {
    "_postman_id": "54f82807-9f8b-4af8-b842-dev3-store-isolation",
    "name": "AI Commerce Store Isolation Smoke Tests",
    "description": "Local Developer 3 smoke tests for store context, publishable API key behavior, admin auth, product category isolation, product isolation, and cross-store negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName && pm.info.requestName.startsWith('01 ')) {",
          "  pm.collectionVariables.set('smoke_run_id', `${Date.now()}-${Math.floor(Math.random() * 100000)}`);",
          "}",
          "if (!pm.collectionVariables.get('smoke_run_id')) {",
          "  pm.collectionVariables.set('smoke_run_id', `${Date.now()}-${Math.floor(Math.random() * 100000)}`);",
          "}",
          "if (!pm.environment.get('base_url')) { pm.environment.set('base_url', 'http://localhost:9000'); }",
          "if (!pm.environment.get('default_store_id')) { pm.environment.set('default_store_id', 'default_store'); }",
          "if (!pm.environment.get('test_store_id')) { pm.environment.set('test_store_id', 'test_store'); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "smoke_run_id", "value": "" },
    { "key": "default_category_id", "value": "" },
    { "key": "test_category_id", "value": "" },
    { "key": "default_product_id", "value": "" },
    { "key": "test_product_id", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health returns 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Store context returns a store id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/store-context"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('store_id is present', () => pm.expect(json.store_context.store_id).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Store context resolves test store from header",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Store-Id", "value": "{{test_store_id}}" }
        ],
        "url": "{{base_url}}/store-context"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('store_id matches test store', () => pm.expect(json.store_context.store_id).to.eql(pm.environment.get('test_store_id')));",
              "pm.test('source is header', () => pm.expect(json.store_context.source).to.eql('header'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Store products without publishable key is blocked",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/store/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is blocked non-2xx', () => pm.expect(pm.response.code).to.not.be.within(200, 299));",
              "const json = pm.response.json();",
              "const text = `${json.message || ''} ${json.type || ''}`;",
              "pm.test('response mentions publishable API key', () => pm.expect(text.toLowerCase()).to.match(/publishable|api key|not_allowed/));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Admin users me with bearer token returns 200",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/admin/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin token is configured', () => pm.expect(pm.environment.get('admin_token')).to.be.a('string').and.not.empty);",
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
