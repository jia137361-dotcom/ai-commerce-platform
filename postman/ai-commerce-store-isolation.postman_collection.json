      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403', () => pm.response.to.have.status(403));",
              "const json = pm.response.json();",
              "pm.test('error is PRODUCT_STORE_MISMATCH', () => pm.expect(json.error.code).to.eql('PRODUCT_STORE_MISMATCH'));"
            ]
          }
        }
