    {
      "name": "08 Storefront default category isolation",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-publishable-api-key", "value": "{{publishable_api_key}}" },
          { "key": "X-Store-Id", "value": "{{default_store_id}}" }
        ],
        "url": "{{base_url}}/store/product-categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "const store = pm.environment.get('default_store_id');",
              "const own = pm.collectionVariables.get('default_category_id');",
              "const other = pm.collectionVariables.get('test_category_id');",
              "pm.test('store_id matches default store', () => pm.expect(json.store_id).to.eql(store));",
              "pm.test('includes default smoke category', () => pm.expect(json.categories.some((c) => c.category_id === own && c.store_id === store)).to.eql(true));",
              "pm.test('all categories belong to default store', () => pm.expect(json.categories.every((c) => c.store_id === store)).to.eql(true));",
              "pm.test('does not include test smoke category', () => pm.expect(json.categories.some((c) => c.category_id === other)).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Storefront test category isolation",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-publishable-api-key", "value": "{{publishable_api_key}}" },
