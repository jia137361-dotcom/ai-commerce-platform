              "const json = pm.response.json();",
              "const store = pm.environment.get('test_store_id');",
              "const own = pm.collectionVariables.get('test_category_id');",
              "const other = pm.collectionVariables.get('default_category_id');",
              "pm.test('store_id matches test store', () => pm.expect(json.store_id).to.eql(store));",
              "pm.test('includes test smoke category', () => pm.expect(json.categories.some((c) => c.category_id === own && c.store_id === store)).to.eql(true));",
              "pm.test('all categories belong to test store', () => pm.expect(json.categories.every((c) => c.store_id === store)).to.eql(true));",
              "pm.test('does not include default smoke category', () => pm.expect(json.categories.some((c) => c.category_id === other)).to.eql(false));"
            ]
          }
        }
      ]
    },
