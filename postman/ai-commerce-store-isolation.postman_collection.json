        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Smoke Bad Category Product {{smoke_run_id}}\",\n  \"description\": \"Should fail due to cross-store category id\",\n  \"price\": 33.33,\n  \"source\": \"manual\",\n  \"category_ids\": [\"{{test_category_id}}\"],\n  \"tags\": [\"dev3-smoke\"],\n  \"variants\": [],\n  \"metadata\": {\"smoke\": true, \"expected_failure\": true}\n}"
        },
