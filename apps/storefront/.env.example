VITE_AI_WORKER_BASE_URL=http://127.0.0.1:8001
VITE_AI_WORKER_PUBLIC_BASE_URL=http://127.0.0.1:8001/static
VITE_MEDUSA_BASE_URL=http://127.0.0.1:9000
VITE_MEDUSA_BACKEND_URL=http://127.0.0.1:9000
VITE_PUBLISHABLE_API_KEY=pk_replace_me
VITE_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
# Optional legacy fallback for /store and store-scoped ops without URL context.
# Multi-store browsing uses /shops/:slug and ?store= — not this value.
VITE_DEFAULT_STORE_ID=default_store
# Stripe Dashboard -> Developers -> API keys -> Publishable key
# Use pk_test_... here. Never put sk_test_... in the storefront.
VITE_STRIPE_PK=pk_test_xxx

NEXT_PUBLIC_AI_WORKER_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://127.0.0.1:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
# Legacy alias; see VITE_DEFAULT_STORE_ID above.
NEXT_PUBLIC_STORE_ID=default_store
