# =============================================================================
# Seller Dashboard 生产环境 Dockerfile
# =============================================================================

FROM node:20-slim AS builder
WORKDIR /app

# 复制根 package 文件和 workspaces 配置
COPY package*.json ./

# 复制共享包
COPY packages/shared-types/ ./packages/shared-types/

# 复制 seller-dashboard package 文件
COPY apps/seller-dashboard/package*.json ./apps/seller-dashboard/
COPY apps/seller-dashboard/tsconfig*.json ./apps/seller-dashboard/
COPY apps/seller-dashboard/postcss.config.js ./apps/seller-dashboard/
COPY apps/seller-dashboard/tailwind.config.js ./apps/seller-dashboard/

# 安装依赖
RUN npm ci

# 复制 seller-dashboard 源代码
COPY apps/seller-dashboard/ ./apps/seller-dashboard/

# 构建
WORKDIR /app/apps/seller-dashboard
RUN npm run build

# 生产镜像
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/apps/seller-dashboard/dist /usr/share/nginx/html

# 复制 nginx 配置
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
