# =============================================================================
# MedusaJS Backend 生产环境 Dockerfile
# =============================================================================

FROM node:20-slim AS base

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制根 package 文件
COPY package*.json ./

# 复制共享包
COPY packages/shared-types/ ./packages/shared-types/

# 复制后端 package 文件
COPY apps/medusa-backend/package*.json ./apps/medusa-backend/

# 安装所有依赖
RUN npm ci

# 复制后端源代码
COPY apps/medusa-backend/ ./apps/medusa-backend/

# 构建后端 (跳过脚本和测试文件的类型检查)
WORKDIR /app/apps/medusa-backend
RUN npx tsc -p tsconfig.build.json --noEmit false --outDir .medusa/server

# 生产镜像
FROM node:20-slim

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    python3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制构建产物和依赖
COPY --from=base /app/apps/medusa-backend ./apps/medusa-backend
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages ./packages
COPY --from=base /app/package.json ./

WORKDIR /app/apps/medusa-backend

# 暴露端口
EXPOSE 9000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:9000/health || exit 1

# 启动
CMD ["npm", "start"]
