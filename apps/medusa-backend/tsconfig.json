{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".medusa/server"
  },
  "include": [
    "src/**/*.ts",
    "medusa-config.ts"
  ],
  "exclude": [
    "src/__tests__/**"
  ],
  "ts-node": {
    "files": true
  }
}
