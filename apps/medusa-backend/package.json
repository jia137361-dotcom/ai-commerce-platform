{
  "name": "@ai-commerce/medusa-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop --port 9001",
    "build": "medusa build",
    "start": "medusa start --port 9001",
    "db:generate": "medusa db:generate store_core",
    "db:migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "s2bdiy:sync-products": "medusa exec ./src/scripts/sync-s2bdiy-products.ts",
    "platform:ops:bootstrap": "medusa exec ./src/scripts/platform-ops-bootstrap.ts",
    "dev:accounts:bootstrap": "medusa exec ./src/scripts/dev-accounts-bootstrap.ts",
    "dev:accounts:verify": "node ./src/scripts/dev-accounts-verify.mjs",
    "email:auth-smoke": "ts-node ./src/scripts/test-auth-email.ts",
    "auth:inspect-buyer": "medusa exec ./src/scripts/inspect-buyer-auth-account.ts",
    "ai-studio:bootstrap": "medusa exec ./src/scripts/ai-studio-supplier-bootstrap.ts",
    "s2bdiy:verify": "node ./scripts/s2bdiy-verify-credentials.mjs",
    "s2bdiy:backfill-buyer-materials": "medusa exec ./src/scripts/backfill-buyer-ai-materials.ts",
    "dev:all": "npm --prefix ../.. run dev:all",
    "dev:full": "npm --prefix ../.. run dev:full",
    "dev:ai-worker": "npm --prefix ../.. run dev:ai-worker",
    "regions:bootstrap": "medusa exec ./src/scripts/bootstrap-market-regions.ts",
    "shipping:bootstrap": "medusa exec ./src/scripts/bootstrap-market-shipping.ts",
    "stripe:region:setup": "medusa exec ./src/scripts/enable-stripe-region.ts",
    "paypal:region:setup": "medusa exec ./src/scripts/enable-paypal-region.ts",
    "pay-paypal:e2e:setup": "medusa exec ./src/scripts/pay-paypal-e2e-setup.ts",
    "pay-paypal:http-smoke": "node ./src/scripts/pay-paypal-http-smoke.mjs",
    "pay-paypal:live-e2e": "node ./src/scripts/pay-paypal-live-e2e.mjs",
    "pay-paypal:replace-stale-order": "node ./src/scripts/pay-paypal-replace-stale-order.mjs",
    "pay-paypal:recovery-reuse-check": "medusa exec ./src/scripts/pay-paypal-recovery-reuse-check.ts",
    "pay-paypal:reset-test-buyer-password": "medusa exec ./src/scripts/pay-paypal-reset-test-buyer-password.ts",
    "pay-stripe:e2e:setup": "medusa exec ./src/scripts/pay-stripe-e2e-setup.ts",
    "pay-stripe:reset-test-passwords": "medusa exec ./src/scripts/pay-stripe-reset-test-buyer-passwords.ts",
    "pay-stripe:reset-test-seller-password": "medusa exec ./src/scripts/pay-stripe-reset-test-seller-password.ts",
    "pay-stripe:http-smoke": "node ./src/scripts/pay-stripe-http-smoke.mjs",
    "pay-stripe:live-e2e": "node ./src/scripts/pay-stripe-live-e2e.mjs",
    "test": "npx jest -c jest.config.cjs --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.15.0",
    "@medusajs/framework": "^2.14.2",
    "@medusajs/locking-postgres": "^2.14.2",
    "@medusajs/medusa": "^2.14.2",
    "@medusajs/payment-stripe": "^2.14.2",
    "@medusajs/utils": "^2.14.2",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.14.2",
    "@medusajs/test-utils": "^2.14.2",
    "@swc/core": "^1.11.24",
    "@swc/jest": "^0.2.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
