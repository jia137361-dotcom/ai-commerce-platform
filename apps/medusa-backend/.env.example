# =============================================================================
# 环境变量模板 — 复制为 apps/medusa-backend/.env 后填写
# Medusa + ai-worker + 测试脚本 共用此文件
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Medusa 核心
# -----------------------------------------------------------------------------
# 本地 Docker: postgres://medusa:medusa@localhost:5433/ai_commerce
# 云端 Neon 示例: postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL=postgres://medusa:medusa@localhost:5433/ai_commerce
# 本地 Docker: redis://localhost:6379
# 云端 Upstash (TLS): rediss://default:token@host:6379
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev_jwt_secret
COOKIE_SECRET=dev_cookie_secret

STORE_CORS=http://127.0.0.1:5174,http://localhost:5174,http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5176,http://localhost:5176,http://localhost:7000,http://localhost:7001
AUTH_CORS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5176,http://localhost:5176,http://localhost:7000,http://localhost:7001

# Backend public URL (local uses 9001 to avoid conflict with other-project MinIO on 9000)
MEDUSA_BACKEND_URL=http://localhost:9001
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
DEFAULT_STORE_ID=01KX2P21ZPPSRYY6VJJERRBQYG
STOREFRONT_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. 支付 & Store API
# -----------------------------------------------------------------------------
PUBLISHABLE_API_KEY=pk_replace_me
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Seller payouts (Stripe Connect): platform account must enable Connect first
# Test: https://dashboard.stripe.com/test/connect
STRIPE_CONNECT_COUNTRY=US
SELLER_DASHBOARD_URL=http://127.0.0.1:5173

# PayPal Sandbox only. Keep the client secret on Medusa; never expose it to the storefront.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=CiiVerse
# Buyer cashback withdrawals. Use mock locally; sandbox calls PayPal Payouts and
# requires Payouts permission on the PayPal app. Production stays disabled until
# a live-capable payout client and webhook reconciliation are configured.
PAYPAL_PAYOUTS_MODE=mock
WALLET_MIN_WITHDRAWAL_MAJOR=5

# -----------------------------------------------------------------------------
# 3. 邮件服务 (Resend)
# -----------------------------------------------------------------------------
AUTH_EMAIL_DELIVERY_MODE=local
# Local development only. Keep false in staging/production.
AUTH_DEV_CODE_ENABLED=false
# Comma-separated buyer emails exempt from Gmail/Apple allowlist (bootstrap / QA).
BUYER_AUTH_TEST_EMAILS=1355026750@qq.com
# Session JWT duration for OTP login (jsonwebtoken style, e.g. 7d / 30d).
BUYER_SESSION_TTL_SHORT=7d
BUYER_SESSION_TTL_REMEMBER=30d

# Google OAuth (buyer). Leave blank to disable the google auth provider.
# Redirect URI must match the storefront callback page exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Preferred: storefront URL that completes Medusa's /auth/customer/google/callback
GOOGLE_CALLBACK_URL=http://127.0.0.1:5174/auth/google/callback
# Optional actor-specific overrides (seller reserved for later)
GOOGLE_BUYER_CALLBACK_URL=
GOOGLE_SELLER_CALLBACK_URL=
# Optional MFA encryption for Auth module (falls back to COOKIE_SECRET)
AUTH_MFA_ENCRYPTION_KEY=

RESEND_API_KEY=
EMAIL_FROM=Ciiverse <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# 4. Medusa ↔ AI Worker 桥接
# -----------------------------------------------------------------------------
AI_WORKER_BASE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 4. AI 生图（ai-worker 读取本文件）
# -----------------------------------------------------------------------------
AI_WORKER_MOCK_GENERATION=true
IMAGE_GEN_PROVIDER=dashscope

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro
DASHSCOPE_IMAGE_SIZE=2K
DASHSCOPE_IMAGE_WATERMARK=false
DASHSCOPE_IMAGE_THINKING_MODE=true
DASHSCOPE_TIMEOUT_SECONDS=180
COPY_GEN_PROVIDER=dashscope
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus

FAL_KEY=
FAL_MODEL=fal-ai/flux-2-pro
FAL_UPSCALE_MODEL=fal-ai/esrgan
FAL_TIMEOUT_SECONDS=360
FAL_UPSCALE_SCALE=2

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_TIMEOUT_SECONDS=120

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

AI_WORKER_HOST=0.0.0.0
AI_WORKER_PORT=8001
MEDUSA_BASE_URL=http://localhost:9001
AI_WORKER_UPLOAD_DIR=var/uploads
AI_WORKER_PUBLIC_BASE_URL=http://127.0.0.1:8001/static

# Pricing (CNY → USD conversion with tiered markup)
AI_WORKER_USD_CNY_RATE=6.77
AI_WORKER_PRICE_MARKUP_MIN=2.3
AI_WORKER_PRICE_MARKUP_MAX=3.0

# -----------------------------------------------------------------------------
# 5. 脚本 / E2E 自检
# -----------------------------------------------------------------------------
ADMIN_TOKEN=eyJ_replace_me
REGION_ID=reg_phase1_us
DEFAULT_MEDUSA_VARIANT_ID=variant_replace_me
DEFAULT_MEDUSA_PRODUCT_ID=prod_replace_me
TEST_MEDUSA_VARIANT_ID=variant_test_store_replace_me
TEST_MEDUSA_PRODUCT_ID=prod_test_store_replace_me

# -----------------------------------------------------------------------------
# 6. S2BDIY 供应商
# 本地 demo 建议 S2BDIY_MOCK_MODE=true（AppSecret 无效时不报错）
S2BDIY_MOCK_MODE=true
S2BDIY_API_BASE_URL=https://opentest.s2bdiy.com
S2BDIY_APP_KEY=wm001
S2BDIY_APP_SECRET=replace_me_or_use_eolink_test_secret
S2BDIY_PLATFORM_ID=99
S2BDIY_DEFAULT_WEIGHT=225
S2BDIY_DEFAULT_LENGTH=20
S2BDIY_DEFAULT_WIDTH=20
S2BDIY_DEFAULT_HEIGHT=10
S2BDIY_TEST_BASIC_PRODUCT_ID=1672
S2BDIY_TEST_COLOR_ID=6
S2BDIY_TEST_SIZE_ID=20
S2BDIY_TEST_VIEW_ID=1
S2BDIY_STORE_ID=4390
# S2BDIY_TEST_LOGISTICS_ID=

# -----------------------------------------------------------------------------
# 7. Platform Ops（运营台）
# 首次：medusa exec ./src/scripts/platform-ops-bootstrap.ts
PLATFORM_OPS_OPERATOR_EMAIL=1355026750@qq.com
