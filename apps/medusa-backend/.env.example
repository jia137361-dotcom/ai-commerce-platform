# 全项目本地环境变量（Medusa / 脚本 / ai-worker 共用）
# 复制为 apps/medusa-backend/.env 后填写；勿提交 Git

# --- Medusa ---
DATABASE_URL=postgres://medusa:medusa@localhost:5432/ai_commerce
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev_jwt_secret
COOKIE_SECRET=dev_cookie_secret
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:7000,http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001
DEFAULT_STORE_ID=default_store
# 商品分享、邮件模板等使用的店铺前端 URL（生产环境改为真实域名）
STOREFRONT_BASE_URL=http://localhost:3000

PUBLISHABLE_API_KEY=pk_replace_me

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

AI_WORKER_BASE_URL=http://localhost:8001

# --- 脚本自检（phase1-dev2-self-test.sh / phase2a-dev2-e2e.sh / phase2b-e2e.sh）---
# 若 Admin 401：POST /auth/user/emailpass 取 token 后更新
ADMIN_TOKEN=eyJ_replace_me

# Phase 2A/2B E2E：npx medusa exec ./src/scripts/phase1-dev2-bootstrap.ts 输出后填入
REGION_ID=reg_phase1_us
DEFAULT_MEDUSA_VARIANT_ID=variant_replace_me
DEFAULT_MEDUSA_PRODUCT_ID=prod_replace_me
# test_store 隔离测试用（X-Store-Id: test_store 时加购用这个 variant）
TEST_MEDUSA_VARIANT_ID=variant_test_store_replace_me
TEST_MEDUSA_PRODUCT_ID=prod_test_store_replace_me

# --- ai-worker ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
FAL_KEY=
AI_WORKER_HOST=0.0.0.0
AI_WORKER_PORT=8001
AI_WORKER_MOCK_GENERATION=true
MEDUSA_BASE_URL=http://localhost:9000
AI_WORKER_UPLOAD_DIR=var/uploads
AI_WORKER_PUBLIC_BASE_URL=http://localhost:8001/static

# --- S2BDIY Open API (Phase 2B) ---
S2BDIY_API_BASE_URL=https://opentest.s2bdiy.com
# 测试环境体验密钥（见 Eolink 概览 / docs/suppliers/s2bdiy.md）
S2BDIY_APP_KEY=wm001
S2BDIY_APP_SECRET=replace_me_or_use_eolink_test_secret
S2BDIY_PLATFORM_ID=99
# weight 单位为克(g)，与 basicProduct items[].weight 一致（勿填 0.3 这类 kg 值）
S2BDIY_DEFAULT_WEIGHT=225
S2BDIY_DEFAULT_LENGTH=20
S2BDIY_DEFAULT_WIDTH=20
S2BDIY_DEFAULT_HEIGHT=10
# smoke / sync 用选品（scripts/s2bdiy-api-smoke.sh 可自动从列表取第一个）
S2BDIY_TEST_BASIC_PRODUCT_ID=1858
S2BDIY_TEST_COLOR_ID=6
S2BDIY_TEST_SIZE_ID=20
S2BDIY_TEST_VIEW_ID=1
# GET /open/v1/store 返回的店铺 id（wm001 测试账号需先绑定店铺）
S2BDIY_STORE_ID=4390
# 运费试算仍为空时可手动指定 logistics_platform_id
# S2BDIY_TEST_LOGISTICS_ID=
