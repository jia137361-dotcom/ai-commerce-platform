# Dev3 full backend integration pipeline local config.
# Copy to scripts/dev3-full-backend-pipeline.local.env and fill local values.
# Do not commit the local env file.

MEDUSA_BASE_URL=http://127.0.0.1:9000
AI_WORKER_BASE_URL=http://127.0.0.1:8001

PUBLISHABLE_API_KEY=<PUBLISHABLE_API_KEY>
ADMIN_TOKEN=<ADMIN_TOKEN>

AI_WORKER_MOCK_GENERATION=true
RUN_REAL_AI=false
RUN_PHASE2B_S2BDIY=false
DEV3_ALLOW_BLOCKED_AI_WORKER=false

S2BDIY_BASE_URL=<S2BDIY_BASE_URL>
S2BDIY_APP_KEY=<S2BDIY_APP_KEY>
S2BDIY_APP_SECRET=<S2BDIY_APP_SECRET>
S2BDIY_TEST_MODE=true
S2BDIY_BASIC_PRODUCT_ID=<S2BDIY_BASIC_PRODUCT_ID>
S2BDIY_SIZE_ID=<S2BDIY_SIZE_ID>
S2BDIY_COLOR_ID=<S2BDIY_COLOR_ID>
S2BDIY_VIEW_ID=<S2BDIY_VIEW_ID>
S2BDIY_LOGISTICS_ID=<S2BDIY_LOGISTICS_ID>
S2BDIY_ALLOW_CREATE_ORDER=false
S2BDIY_CREATE_ORDER_CONFIRMED_NO_CHARGE=false
S2BDIY_ALLOW_PAYMENT=false
HUMAN_APPROVED_PAYMENT=false

DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
FAL_KEY=<FAL_KEY>
